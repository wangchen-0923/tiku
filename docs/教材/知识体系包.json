  "chapters": [
    {
      "seq": 1,
      "name": "金属材料与热处理",
      "code": "JXJC-C01",
      "part": "第一篇：机械工程材料",
      "part_seq": 1,
      "part_name": "机械工程材料",
      "no_task_layer": false,
      "tasks": [
        {
          "seq": 1,
          "name": "分析轴的力学性能",
          "code": "JXJC-C01-T01",
          "knowledge": [
            {
              "seq": 1,
              "name": "金属材料性能分类",
              "code": "JXJC-C01-T01-K01",
              "entries": [
                "使用性能：物理、化学、力学性能。",
                "工艺性能：铸造、锻造、焊接、切削加工性能。"
              ]
            },
            {
              "seq": 2,
              "name": "重要力学性能指标",
              "code": "JXJC-C01-T01-K02",
              "entries": [
                "强度：抗拉强度(Rm)、屈服强度(ReL/ReH)，抵抗变形和断裂。",
                "塑性：断后伸长率(A)、断面收缩率(Z)，材料产生永久变形而不破坏的能力。",
                "硬度：布氏(HBW)、洛氏(HRA/HRC)、维氏(HV)，抵抗局部变形。",
                "韧性：冲击吸收能量，抵抗冲击载荷。",
                "疲劳强度：抵抗交变载荷破坏的能力。"
              ]
            }
          ]
        },
        {
          "seq": 2,
          "name": "识别非合金钢",
          "code": "JXJC-C01-T02",
          "knowledge": [
            {
              "seq": 1,
              "name": "非合金钢分类",
              "code": "JXJC-C01-T02-K01",
              "entries": [
                "按碳含量：低碳钢(≤0.25%)、中碳钢(0.25%-0.6%)、高碳钢(≥0.6%)。",
                "按质量：普通、优质、高级优质。",
                "按用途：碳素结构钢、碳素工具钢。"
              ]
            },
            {
              "seq": 2,
              "name": "常用非合金钢",
              "code": "JXJC-C01-T02-K02",
              "entries": [
                "普通碳素结构钢(Q235)：用于受力小的零件、焊接件。",
                "优质碳素结构钢(45钢)：用于较重要零件，如轴、齿轮。",
                "非合金工具钢(T12A)：高碳，用于制造低速切削工具（锉刀、丝锥）。"
              ]
            }
          ]
        },
        {
          "seq": 3,
          "name": "选择合金钢",
          "code": "JXJC-C01-T03",
          "knowledge": [
            {
              "seq": 1,
              "name": "低合金钢与合金钢",
              "code": "JXJC-C01-T03-K01",
              "entries": [
                "低合金钢(Q460)：高强度，用于桥梁、船舶。",
                "合金结构钢(40Cr)：用于重要轴、齿轮。",
                "轴承钢(GCr15)：用于滚动轴承。",
                "高速工具钢(W18Cr4V)：具有“红硬性”，用于高速切削刀具（白钢刀）。"
              ]
            }
          ]
        },
        {
          "seq": 4,
          "name": "判别铸铁",
          "code": "JXJC-C01-T04",
          "knowledge": [
            {
              "seq": 1,
              "name": "铸铁的分类与特点",
              "code": "JXJC-C01-T04-K01",
              "entries": [
                "灰铸铁(HT200)：片状石墨，减振好，用于床身、箱体。",
                "可锻铸铁(KTH350-10)：团絮状石墨，韧性较好，用于管件、薄壁件。",
                "球墨铸铁(QT500-7)：球状石墨，力学性能接近钢，用于曲轴、连杆。",
                "蠕墨铸铁(RuT300)：蠕虫状石墨，耐热疲劳好。"
              ]
            }
          ]
        },
        {
          "seq": 5,
          "name": "识别非铁金属",
          "code": "JXJC-C01-T05",
          "knowledge": [
            {
              "seq": 1,
              "name": "铜及铜合金",
              "code": "JXJC-C01-T05-K01",
              "entries": [
                "纯铜(T2)：导电、导热好。",
                "黄铜(H62)：铜锌合金，强度高。",
                "青铜(QSn4-3)：铜锡合金，耐蚀。"
              ]
            },
            {
              "seq": 2,
              "name": "铝及铝合金",
              "code": "JXJC-C01-T05-K02",
              "entries": [
                "纯铝：导电、导热好，塑性好。",
                "铸造铝合金(ZL)：用于壳体、框架。",
                "变形铝合金(LY12)：可压力加工，用于飞机蒙皮、铆钉。"
              ]
            }
          ]
        },
        {
          "seq": 6,
          "name": "轴的热处理",
          "code": "JXJC-C01-T06",
          "knowledge": [
            {
              "seq": 1,
              "name": "整体热处理",
              "code": "JXJC-C01-T06-K01",
              "entries": [
                "退火：缓冷，降低硬度，改善切削加工性。",
                "正火：空冷，细化晶粒，作预备热处理。",
                "淬火：急冷，提高硬度和耐磨性。",
                "回火：淬火后加热，消除脆性。分为低温（高硬度）、中温（高弹性）、高温（综合力学性能，即调质）。"
              ]
            },
            {
              "seq": 2,
              "name": "表面与化学热处理",
              "code": "JXJC-C01-T06-K02",
              "entries": [
                "表面淬火：感应加热、火焰加热，使表面硬而心部韧。",
                "化学热处理：渗碳、渗氮，改变表面化学成分。"
              ]
            }
          ]
        },
        {
          "seq": 7,
          "name": "选择非金属材料",
          "code": "JXJC-C01-T07",
          "knowledge": [
            {
              "seq": 1,
              "name": "高分子材料",
              "code": "JXJC-C01-T07-K01",
              "entries": [
                "塑料：质量轻、耐蚀、绝缘，可作轴承、齿轮。",
                "橡胶：高弹性，用于密封、减振。"
              ]
            },
            {
              "seq": 2,
              "name": "陶瓷与复合材料",
              "code": "JXJC-C01-T07-K02",
              "entries": [
                "陶瓷：高硬度、耐高温，用于高速切削刀具。",
                "复合材料：比强度高，如碳纤维、玻璃钢。"
              ]
            }
          ]
        }
      ]
    },
    {
      "seq": 2,
      "name": "机构",
      "code": "JXJC-C02",
      "part": "第二篇：常用机构",
      "part_seq": 2,
      "part_name": "常用机构",
      "no_task_layer": false,
      "tasks": [
        {
          "seq": 1,
          "name": "平面连杆机构",
          "code": "JXJC-C02-T01",
          "knowledge": [
            {
              "seq": 1,
              "name": "铰链四杆机构",
              "code": "JXJC-C02-T01-K01",
              "entries": [
                "曲柄摇杆机构：一个曲柄，一个摇杆（如缝纫机踏板）。",
                "双曲柄机构：两个曲柄（如机车车轮联动机构）。",
                "双摇杆机构：两个摇杆（如鹤式起重机）。"
              ]
            },
            {
              "seq": 2,
              "name": "基本特性",
              "code": "JXJC-C02-T01-K02",
              "entries": [
                "急回特性：空回行程快，提高效率，用行程速比系数K表示。",
                "死点位置：从动件与连杆共线，机构卡死。可克服（如缝纫机）或利用（如飞机起落架）。"
              ]
            },
            {
              "seq": 3,
              "name": "机构演化",
              "code": "JXJC-C02-T01-K03",
              "entries": [
                "曲柄滑块机构（内燃机）、曲柄摇块机构（油泵）、偏心轮机构（冲床）。"
              ]
            }
          ]
        },
        {
          "seq": 2,
          "name": "凸轮机构",
          "code": "JXJC-C02-T02",
          "knowledge": [
            {
              "seq": 1,
              "name": "凸轮机构组成与类型",
              "code": "JXJC-C02-T02-K01",
              "entries": [
                "组成：凸轮、从动件、机架。",
                "按形状：盘形、移动、圆柱。",
                "按从动件：尖顶、滚子、平底。"
              ]
            },
            {
              "seq": 2,
              "name": "工作过程与特点",
              "code": "JXJC-C02-T02-K02",
              "entries": [
                "工作循环：推程 → 远休止 → 回程 → 近休止。",
                "优点：可使从动件实现任意预期运动。",
                "缺点：易磨损，只用于传力不大的场合。"
              ]
            }
          ]
        },
        {
          "seq": 3,
          "name": "间歇机构",
          "code": "JXJC-C02-T03",
          "knowledge": [
            {
              "seq": 1,
              "name": "棘轮机构",
              "code": "JXJC-C02-T03-K01",
              "entries": [
                "组成：棘爪、棘轮。",
                "特点：结构简单，转角可调，但冲击噪声大。",
                "应用：自行车超越离合、千斤顶。"
              ]
            },
            {
              "seq": 2,
              "name": "槽轮机构",
              "code": "JXJC-C02-T03-K02",
              "entries": [
                "组成：拨盘、槽轮。",
                "特点：转位迅速平稳，转角不可调。",
                "应用：电影放映机、刀架转位机构。"
              ]
            }
          ]
        }
      ]
    },
    {
      "seq": 3,
      "name": "连接",
      "code": "JXJC-C03",
      "part": "第三篇：机械传动与支承零件",
      "part_seq": 3,
      "part_name": "机械传动与支承零件",
      "no_task_layer": false,
      "tasks": [
        {
          "seq": 1,
          "name": "销、螺纹、键连接",
          "code": "JXJC-C03-T01",
          "knowledge": [
            {
              "seq": 1,
              "name": "销连接",
              "code": "JXJC-C03-T01-K01",
              "entries": [
                "类型：圆柱销（定位）、圆锥销、开口销（防松）。"
              ]
            },
            {
              "seq": 2,
              "name": "螺纹连接",
              "code": "JXJC-C03-T01-K02",
              "entries": [
                "参数：大径、小径、中径、螺距、导程、线数、旋向。",
                "类型：普通螺纹(M)、管螺纹、梯形螺纹(Tr)。",
                "防松：摩擦防松（弹簧垫圈）、机械防松（开口销）、永久防松。"
              ]
            },
            {
              "seq": 3,
              "name": "键连接",
              "code": "JXJC-C03-T01-K03",
              "entries": [
                "平键：工作面为两侧面，用于高精度、高速场合。",
                "花键：多齿承载，承载能力强，定心好。",
                "楔键：工作面上下面，传递单向轴向力。"
              ]
            }
          ]
        },
        {
          "seq": 2,
          "name": "联轴器与离合器",
          "code": "JXJC-C03-T02",
          "knowledge": [
            {
              "seq": 1,
              "name": "联轴器",
              "code": "JXJC-C03-T02-K01",
              "entries": [
                "刚性（凸缘）：无补偿能力，需严格对中。",
                "挠性：有补偿能力，分有弹性元件（梅花形，可缓冲）和无弹性元件（万向，补偿角度大）。"
              ]
            },
            {
              "seq": 2,
              "name": "离合器",
              "code": "JXJC-C03-T02-K02",
              "entries": [
                "牙嵌式：结构简单，需低速接合。",
                "摩擦式：可在高速下平稳接合。",
                "超越式：按转速变化自动接合/分离。"
              ]
            }
          ]
        },
        {
          "seq": 3,
          "name": "胀紧连接",
          "code": "JXJC-C03-T03",
          "knowledge": [
            {
              "seq": 1,
              "name": "胀紧连接",
              "code": "JXJC-C03-T03-K01",
              "entries": [
                "原理：利用螺钉产生径向压力，依靠摩擦力传递载荷。",
                "特点：拆装方便，定心好，不削弱轴强度，但成本高。"
              ]
            }
          ]
        }
      ]
    },
    {
      "seq": 4,
      "name": "轴承与轴",
      "code": "JXJC-C04",
      "part": "第三篇：机械传动与支承零件",
      "part_seq": 3,
      "part_name": "机械传动与支承零件",
      "no_task_layer": false,
      "tasks": [
        {
          "seq": 1,
          "name": "轴承",
          "code": "JXJC-C04-T01",
          "knowledge": [
            {
              "seq": 1,
              "name": "滚动轴承",
              "code": "JXJC-C04-T01-K01",
              "entries": [
                "结构：内圈、外圈、滚动体、保持架。",
                "代号：基本代号由类型代号、尺寸系列代号、内径代号组成。（如6207）",
                "特点：摩擦小、互换性好，但抗冲击差。"
              ]
            },
            {
              "seq": 2,
              "name": "滑动轴承",
              "code": "JXJC-C04-T01-K02",
              "entries": [
                "结构：轴承座、轴瓦。",
                "类型：整体式、剖分式。",
                "特点：耐冲击、运行平稳、寿命长。"
              ]
            }
          ]
        },
        {
          "seq": 2,
          "name": "轴及轴上零件",
          "code": "JXJC-C04-T02",
          "knowledge": [
            {
              "seq": 1,
              "name": "轴的分类",
              "code": "JXJC-C04-T02-K01",
              "entries": [
                "按受载：转轴（受弯扭，如减速器轴）、心轴（只受弯，如自行车前轴）、传动轴（只受扭，如汽车传动轴）。"
              ]
            },
            {
              "seq": 2,
              "name": "轴上零件固定",
              "code": "JXJC-C04-T02-K02",
              "entries": [
                "轴向固定：轴肩、套筒、圆螺母、弹性挡圈。",
                "周向固定：键、花键、过盈配合、销。"
              ]
            }
          ]
        }
      ]
    },
    {
      "seq": 5,
      "name": "机械传动",
      "code": "JXJC-C05",
      "part": "第三篇：机械传动与支承零件",
      "part_seq": 3,
      "part_name": "机械传动与支承零件",
      "no_task_layer": false,
      "tasks": [
        {
          "seq": 1,
          "name": "带传动",
          "code": "JXJC-C05-T01",
          "knowledge": [
            {
              "seq": 1,
              "name": "V带传动",
              "code": "JXJC-C05-T01-K01",
              "entries": [
                "原理：依靠摩擦力。",
                "传动比：i = n₁/n₂ = D₂/D₁（存在弹性滑动，不准确）。"
              ]
            },
            {
              "seq": 2,
              "name": "同步带传动",
              "code": "JXJC-C05-T01-K02",
              "entries": [
                "原理：依靠啮合，无相对滑动。",
                "传动比：i = n₁/n₂ = z₂/z₁（准确）。"
              ]
            },
            {
              "seq": 3,
              "name": "张紧与维护",
              "code": "JXJC-C05-T01-K03",
              "entries": [
                "张紧方法：调整中心距、使用张紧轮。",
                "安装：两轮槽对正，避免强行撬入。"
              ]
            }
          ]
        },
        {
          "seq": 2,
          "name": "链传动",
          "code": "JXJC-C05-T02",
          "knowledge": [
            {
              "seq": 1,
              "name": "滚子链",
              "code": "JXJC-C05-T02-K01",
              "entries": [
                "结构：内/外链板、销轴、套筒、滚子。",
                "参数：节距p、排数。",
                "特点：平均传动比准确，无打滑，但有噪声。"
              ]
            },
            {
              "seq": 2,
              "name": "布置与维护",
              "code": "JXJC-C05-T02-K02",
              "entries": [
                "布置原则：紧边在上，松边在下。",
                "润滑：重要，可减少磨损。"
              ]
            }
          ]
        },
        {
          "seq": 3,
          "name": "螺旋传动",
          "code": "JXJC-C05-T03",
          "knowledge": [
            {
              "seq": 1,
              "name": "滑动与滚动螺旋",
              "code": "JXJC-C05-T03-K01",
              "entries": [
                "滑动螺旋：结构简单，能自锁，效率低。",
                "滚动螺旋（滚珠丝杠）：效率高，精度高，成本高，用于数控机床。"
              ]
            },
            {
              "seq": 2,
              "name": "运动形式与判定",
              "code": "JXJC-C05-T03-K02",
              "entries": [
                "运动形式：单动（螺杆转并移）、双动（螺母移）。",
                "移动方向判定：左右手法则（右旋用右手）。"
              ]
            },
            {
              "seq": 3,
              "name": "差动螺旋",
              "code": "JXJC-C05-T03-K03",
              "entries": [
                "两段螺纹导程不同，可实现微动（L = N(PhA ± PhB)）。"
              ]
            }
          ]
        },
        {
          "seq": 4,
          "name": "齿轮传动",
          "code": "JXJC-C05-T04",
          "knowledge": [
            {
              "seq": 1,
              "name": "标准直齿圆柱齿轮",
