# 知否 · 渲染服务环境变量
#
# ★ RENDER_TOKEN 是**内网共享密钥**，不是用户 JWT。
#   渲染服务不判断「这是谁」，只判断「请求是不是 Django 发来的」。
#   越权判断一律留在 Django（那里才有 for_org() 与权限类）。
#
#   没有配它服务会**拒绝启动** —— 一个无鉴权的渲染服务放在内网，
#   就是一台谁都能用的 PDF 生成器。

RENDER_TOKEN=change-me-please
RENDER_PORT=7001

# 浏览器并发上限。Chromium 单个 page 打印峰值 100–200MB，
# 并发 10 就是 2GB，容器会被 OOM killer 干掉。
RENDER_CONCURRENCY=2

# 单次渲染超时（毫秒）。Django 侧 ZF_RENDER_TIMEOUT 要比它大 5s 左右，
# 让「服务端超时」先触发，而不是客户端先放弃。
RENDER_TIMEOUT_MS=30000

# 请求体上限（配图走 base64，含 10 张图的卷子可到 20MB+）
RENDER_MAX_BODY=64mb

# 本地调试专用：跳过令牌校验。**生产绝对不要开**。
# RENDER_ALLOW_INSECURE=1

# 用镜像里自带的 Chromium（不设则用 puppeteer 缓存目录里的那份）
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
