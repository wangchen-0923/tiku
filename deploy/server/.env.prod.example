# ══════════════════════════════════════════════════════════════
#  知否 · 生产环境变量样例
#
#  ★ 用法：把本文件复制到服务器 /opt/zhifou/ 目录下，**改名为 .env**
#      （前面的点不能少，否则 docker compose 读不到）
#      cp .env.prod.example .env
#      然后按下面注释把 <请生成> 的几项填掉。
#
#  ★★ 三条铁律（违反必踩坑）：
#      1. 等号两边**不要加空格**：写 `KEY=value`，不要写 `KEY = value`
#      2. 值**不要加引号**：写 `KEY=abc`，不要写 `KEY="abc"`
#         （加了引号，引号会变成密码的一部分）
#      3. 值里**不要出现 # 和空格**（# 后面的内容会被当成注释丢掉）
#         生成口令请用下面给的字母数字命令，不要用自己随手编的口令
#
#  ★ 本文件里没有任何真实密钥，全部是 <请生成> 占位。
#    ★ 改好后的 .env 千万别提交到 git（含真实密码）。
# ══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
#  一、Django 基础
# ──────────────────────────────────────────────────────────────

# 使用哪个配置模块。★ 这一项不要改，就是 serverprod
DJANGO_SETTINGS_MODULE=zhifou.settings.serverprod

# 站点密钥（会话、签名都靠它）。★ 缺失会**直接启动失败**（有意为之）
# 生成命令（在你自己电脑上执行，把输出粘到等号后面）：
#     python -c "import secrets;print(secrets.token_urlsafe(50))"
# ⚠ 改了这个值，所有已登录用户会被强制退出，请在上线前定好、之后别动。
ZF_SECRET_KEY=<请生成>

# 允许访问的域名/IP，多个用英文逗号分隔，**不要带 http://，不要带端口**
# ★ 缺失也会**直接启动失败**（有意为之）
# ★ 如果还没域名、先用 IP 访问，就填服务器的公网 IP
# 例：ZF_ALLOWED_HOSTS=tiku.xxx.cn,1.2.3.4
ZF_ALLOWED_HOSTS=<改成你的域名或公网IP>

# 允许跨域访问的前端来源，多个用英文逗号分隔，**必须带 https://**
# ★ 现阶段留空：前端 dist 和 Nginx 同域，不存在跨域。
#   以后前端独立部署到别的域名时再填，例如：
#   ZF_CORS_ORIGINS=https://tiku.xxx.cn
ZF_CORS_ORIGINS=

# CSRF 信任来源（可选）。留空则自动沿用上面的 ZF_CORS_ORIGINS。
# 只有在「前端与后端不同域」且要 POST 时才需要填。
ZF_CSRF_TRUSTED_ORIGINS=


# ──────────────────────────────────────────────────────────────
#  二、PostgreSQL（前三项给 compose 建库用，后五项给 Django 连库用）
#
#  ★★ 为什么同一个值要写两遍：
#      POSTGRES_* 是 postgres 官方镜像认的变量（首次启动建库/建用户）；
#      ZF_DB_*    是本项目 settings 认的变量（运行时连库）。
#      两边必须一致，否则会「库建好了但 Django 连不上」。
#  ★ 数据库**不映射宿主机端口**，只在容器网络内互通，所以 HOST 就是
#    compose 里的服务名 `db`，不要改成 127.0.0.1 或 localhost。
# ──────────────────────────────────────────────────────────────

POSTGRES_DB=zhifou
POSTGRES_USER=zhifou
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=<请生成>

ZF_DB_NAME=zhifou
ZF_DB_USER=zhifou
# ★ 必须与上面的 POSTGRES_PASSWORD 完全一致
ZF_DB_PASSWORD=<请生成>
# ★ 固定写 db（compose 服务名）
ZF_DB_HOST=db
# ★ 容器内端口，固定 5432
ZF_DB_PORT=5432


# ──────────────────────────────────────────────────────────────
#  三、Redis（Celery 消息队列 + Django 缓存）
# ──────────────────────────────────────────────────────────────

# ★ 固定写 redis://redis:6379/0（redis 是 compose 服务名）
ZF_REDIS_URL=redis://redis:6379/0

# 缓存后端。★ 留空 = 用上面的 Redis（正确做法）。
#   只有一种情况才填 locmem：Redis 挂了要临时应急。
#   ⚠ 填了 locmem 后，限流会变成「每个进程各算各的」，等于没限流。
ZF_CACHE=


# ──────────────────────────────────────────────────────────────
#  四、业务开关
# ──────────────────────────────────────────────────────────────

# 扫描识别的执行方式：thread（本机线程）/ sync（同步）/ celery（交给 worker）
# ★ 服务器上跑着 worker_io，所以选 celery（不占 web 进程，页面不卡）
ZF_SCAN_RECOGNITION=celery

# ★★ 学情重算 / 统计类任务的执行方式，必须显式写 queued（投给 worker_calc）。
#
#    为什么必须写：代码里的默认值是 inline（`apps/analytics/tasks.py:61`），
#    也就是说不配这一项时，重算会**在网页请求里当场算完**——
#    页面转圈几十秒，而 worker_calc 闲着，批改接口还会变慢。
#    ★ 这种失效**不报错**，只有上线后被吐槽「怎么这么慢」才会发现。
ZF_TASK_MODE=queued

# 对象存储：local（存本地磁盘）/ s3（对象存储）
# ★ 现阶段用 local，文件落在 /opt/zhifou/media（由下面的 ZF_STORAGE_ROOT 决定）
#   第二步要切对象存储时改成 s3，并填写下面第七节的 ZF_OSS_* 五项
# ⚠ 注意：用 local 时，图片**不是**由 Nginx 直接吐的，而是由后端
#    /api/v1/media/assets/{id}/content/ 这个**带登录校验**的接口读出。
#    所以 /opt/zhifou/media 不需要（也不应该）对外开放访问。
ZF_STORAGE_BACKEND=local
ZF_STORAGE_BUCKET=
ZF_STORAGE_ENDPOINT=

# ★★ 本地存储的**真实落盘根目录**，固定写 /app/media。
#
#    ★ 为什么必须单独配它：LocalStorage 的根取自 `ZF_STORAGE_ROOT`，
#      取不到才回落到「当前工作目录/.zf-storage」（`apps/media/storage.py:529-533`）。
#      容器工作目录是 /app，所以不配这一项时：
#        · 图片实际写进 **/app/.zf-storage**（不在卷上，重建容器即丢）
#        · 而卷 zf_media 挂在 /app/media，**永远是空的**
#        · 备份脚本打包出来的 media 也是空目录
#      ★ 症状同样是「不报错」：上传成功、能预览，重启后图全没。
#      ★ 注意：ZF_MEDIA_ROOT **不控制**实际写入路径，它只影响/settings 显示。
ZF_STORAGE_ROOT=/app/media

# 媒体文件在**容器内**的路径。★ 固定 /app/media，对应卷 zf_media
# （宿主机上看就是 /opt/zhifou/media）
# ★ 这一项只用于环境自检页的显示，真实写入位置由上面的 ZF_STORAGE_ROOT 决定
ZF_MEDIA_ROOT=/app/media

# ★★ 后端在**宿主机**上映射到哪个端口（容器内始终是 8000）。
#
#    默认 8000，只在一种情况下要改：宿主机 8000 已经被别的程序占用。
#    典型场景：这台机器上还跑着另一个 Python 服务（uvicorn / gunicorn），
#    它占着 127.0.0.1:8000，知否再用 8000 就会冲突——容器直接起不来，
#    报 `port is already allocated`；更隐蔽的情况是没报错，
#    但 Nginx 把知否的请求转给了那个旧程序，页面内容对不上。
#
#    ★ 判定命令（有输出就说明被占了，换个端口）：
#         ss -lntp | grep ':8000 '
#
#    ★★ 改这个值时必须同步改两处，漏一处就白改：
#        1) Nginx 站点配置里所有 proxy_pass http://127.0.0.1:8000;
#           → 改成同一个端口
#        2) 改完执行  cd /opt/zhifou && docker compose -p zhifou up -d
#           让容器按新端口重建
ZF_WEB_HOST_PORT=8000


# ──────────────────────────────────────────────────────────────
#  四·五、临时开关：域名还没备案 / 还没域名，先用公网 IP 试用
#
#  ★ 默认【不设置】= 强制 HTTPS + 安全 Cookie + HSTS，这是正确状态。
#
#  ★ 什么时候才设成 1：
#    大陆服务器的 80/443 只放行「已完成接入备案」的域名。域名没备案时，
#    请求会被云厂商的「域名未备案」拦截页吃掉，根本到不了 Nginx。
#    这时唯一能进去的通路是公网 IP（http 访问，不走域名、不受备案限制）。
#
#  ★ 设成 1 之后后端会关掉：
#      SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE / HSTS
#    不关的话表现为两种「看起来像 Bug」的现象：
#      1. 所有请求 301 跳 https，但没有证书 → 页面打不开；
#      2. 登录 Cookie 带 Secure，http 下浏览器不回传 → 登录成功但一刷新就掉线。
#
#  ★★ 三条红线：
#    1. 只在试用期打开；
#    2. 打开期间密码明文传输，**不要在校外网络使用**，不要录真实学生敏感信息；
#    3. 域名备案通过、切回 https 之前，必须删掉这一行并重建容器。
#       忘了删 = 永久明文运行，而且不会有任何报错。
#
#  ★ 配套要改的两处（缺一个就用不了）：
#    ·  ZF_ALLOWED_HOSTS 里必须包含公网 IP，建议 IP 放第一位
#    ·  Nginx 站点的 server_name 里也要加上 IP
ZF_ALLOW_INSECURE_HTTP=


# ──────────────────────────────────────────────────────────────
#  五、加密密钥（学生姓名等个人信息的字段级加密）
# ──────────────────────────────────────────────────────────────

# ★★ 这个密钥一旦启用并写入了数据，就**永远不能改**，改了旧数据解不开。
#    上线前务必先备份一份到密码管理器。
# 生成命令（必须是 base64 的 32 字节，别用其它方式生成）：
#     python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ZF_PII_KEK=<请生成>


# ──────────────────────────────────────────────────────────────
#  六、AI 模型（出题 / 解析 / 阅卷建议）
#
#  ★ 没有配 AI 也能正常跑：题库、组卷、答题卡、批改这些核心功能
#    都不依赖它。只是「AI 出题」按钮会报错。
#    等拿到厂商地址再填，不用现在就卡在这里。
# ──────────────────────────────────────────────────────────────

# OpenAI 兼容接口地址，例：https://api.deepseek.com/v1
ZF_AI_BASE_URL=
ZF_AI_API_KEY=
# 模型名，例：deepseek-chat
ZF_AI_MODEL=


# ──────────────────────────────────────────────────────────────
#  七、对象存储（第二步才用，现在**留空即可**）
#
#  ★ 什么时候需要：要部署多台服务器、或者磁盘空间紧张时。
#    单台服务器用本地磁盘就够了，不要提前折腾。
#  ★ 改成 s3 前必须先确认：ZF_STORAGE_BACKEND=s3，且下面五项全填，
#    否则启动时会报「S3 后端缺少配置」。
#  ★ 腾讯云 COS 的 endpoint 形如：https://cos.ap-guangzhou.myqcloud.com
#
#  ★★ 这五项**不需要**给每个服务单独配：compose 里 5 个服务都写了
#     `env_file: .env`，所以它们会同时传给
#     web / worker_io / worker_calc / beat。
#     ★ 为什么强调这点：扫码识别（worker_io）和导出统计（worker_calc）
#       也要读写对象存储。只给 web 配的话，扫出来的图写不进桶，
#       报错却是「存储未配置」而不是「缺环境变量」，非常难查。
# ──────────────────────────────────────────────────────────────

ZF_OSS_BUCKET=
ZF_OSS_ENDPOINT=
ZF_OSS_REGION=
ZF_OSS_KEY=
ZF_OSS_SECRET=


# ──────────────────────────────────────────────────────────────
#  八、其它
# ──────────────────────────────────────────────────────────────

# 容器时区。日志时间和 Celery 定时任务都按它算
TZ=Asia/Shanghai
